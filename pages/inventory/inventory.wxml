<view class="container">
  <view class="section-title">商品库存登记</view>
  <view class="card">
    <view class="form-row"><text class="label">商品名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="请输入商品名称" /></view>
    <view class="form-row"><text class="label">商品规格</text><input class="input" value="{{form.spec}}" data-field="spec" bindinput="onInput" placeholder="颜色 / 尺码 / 型号" /></view>
    <view class="form-row"><text class="label">商品单价</text><input class="input" type="digit" value="{{form.price}}" data-field="price" bindinput="onInput" placeholder="0.00" /></view>
    <view class="form-row"><text class="label">在库数量</text><input class="input" type="number" value="{{form.stock}}" data-field="stock" bindinput="onInput" placeholder="0" /></view>
    <view class="form-row"><text class="label">供应商</text><picker mode="selector" range="{{supplierOptions}}" bindchange="onSupplierPick"><view class="picker-box">{{form.supplier || '请选择供应商'}}</view></picker></view>
    <view class="form-row"><text class="label">预警数量</text><input class="input" type="number" value="{{form.warningQty}}" data-field="warningQty" bindinput="onInput" placeholder="0" /></view>
    <view class="form-row"><text class="label">备注</text><textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="请输入备注" /></view>
    <view class="button-row"><button class="btn" bindtap="saveInventory">{{form.id ? '保存修改' : '添加商品'}}</button><button class="btn secondary" bindtap="resetForm">清空</button></view>
  </view>

  <view class="section-title">供应商货款余额</view>
  <view class="card">
    <view class="form-row"><text class="label">供应商</text><picker mode="selector" range="{{supplierOptions}}" bindchange="onBalanceSupplierPick"><view class="picker-box">{{balanceForm.supplier || '请选择供应商'}}</view></picker></view>
    <view class="form-row"><text class="label">货款余额</text><input class="input" type="digit" value="{{balanceForm.balance}}" data-field="balance" bindinput="onBalanceInput" placeholder="0.00" /></view>
    <view class="form-row"><text class="label">备注</text><input class="input" value="{{balanceForm.remark}}" data-field="remark" bindinput="onBalanceInput" placeholder="可填写账期或说明" /></view>
    <view class="button-row"><button class="btn" bindtap="saveBalance">{{balanceForm.id ? '保存余额' : '添加余额'}}</button><button class="btn secondary" bindtap="resetBalanceForm">清空</button></view>
  </view>

  <view class="section-title">库存记录</view>
  <view class="toolbar"><button class="btn secondary" bindtap="toggleAllInventory">{{allInventorySelected ? '取消全选' : '全选一键'}}</button><button class="btn" bindtap="deleteInventorySelected">删除选中</button></view>
  <view wx:if="{{inventory.length}}">
    <view class="record" wx:for="{{inventory}}" wx:key="id">
      <view class="record-head"><checkbox checked="{{selectedInventory[item.id]}}" data-id="{{item.id}}" bindtap="toggleInventory" /><view class="record-title">{{item.name}}｜{{item.spec}}</view><button size="mini" class="mini-btn" data-id="{{item.id}}" bindtap="editInventory">编辑</button></view>
      <view class="record-text">单价 ¥{{item.price}} ｜ 在库 {{item.stock}} 件 ｜ 预警 {{item.warningQty}} 件</view>
      <view class="record-text">供应商：{{item.supplier}}</view>
      <view class="record-text">备注：{{item.remark || '无'}}</view>
    </view>
  </view>
  <view class="empty" wx:else>暂无库存商品</view>

  <view class="section-title">供应商余额记录</view>
  <view class="toolbar"><button class="btn secondary" bindtap="toggleAllBalances">{{allBalancesSelected ? '取消全选' : '全选一键'}}</button><button class="btn" bindtap="deleteBalanceSelected">删除选中</button></view>
  <view wx:if="{{balances.length}}">
    <view class="record" wx:for="{{balances}}" wx:key="id">
      <view class="record-head"><checkbox checked="{{selectedBalances[item.id]}}" data-id="{{item.id}}" bindtap="toggleBalance" /><view class="record-title">{{item.supplier}}</view><button size="mini" data-id="{{item.id}}" bindtap="editBalance">编辑</button></view>
      <view class="record-text">货款余额：¥{{item.balance}}</view><view class="record-text">备注：{{item.remark || '无'}}</view>
    </view>
  </view>
  <view class="empty" wx:else>暂无供应商货款余额</view>
</view>
