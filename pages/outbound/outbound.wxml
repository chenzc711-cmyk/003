<view class="container">
  <view class="section-title">出库信息登记</view>
  <view class="card">
    <view class="form-row"><text class="label">出库日期</text><picker mode="date" value="{{form.date}}" bindchange="onDatePick"><view class="picker-box">{{form.date || '请选择出库日期'}}</view></picker></view>
    <view class="form-row"><text class="label">库存商品</text><picker mode="selector" range="{{inventoryLabels}}" bindchange="onInventoryPick"><view class="picker-box">{{selectedLabel || '选择后带出名称、规格、单价'}}</view></picker></view>
    <view class="form-row"><text class="label">商品名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">商品规格</text><input class="input" value="{{form.spec}}" data-field="spec" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">数量</text><input class="input" type="number" value="{{form.qty}}" data-field="qty" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">单价</text><input class="input" type="digit" value="{{form.price}}" data-field="price" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">总金额</text><input class="input" type="digit" value="{{form.total}}" data-field="total" bindinput="onInput" placeholder="留空自动计算" /></view>
    <view class="form-row"><text class="label">用途/备注</text><textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" /></view>
    <view class="button-row"><button class="btn" bindtap="saveRecord">{{form.id ? '保存修改' : '添加出库'}}</button><button class="btn secondary" bindtap="resetForm">清空</button></view>
  </view>

  <view class="section-title">成本登记</view>
  <view class="card">
    <view class="form-row"><text class="label">支出时间</text><picker mode="date" value="{{costForm.date}}" bindchange="onCostDatePick"><view class="picker-box">{{costForm.date || '请选择支出时间'}}</view></picker></view>
    <view class="form-row"><text class="label">支出金额</text><input class="input" type="digit" value="{{costForm.amount}}" data-field="amount" bindinput="onCostInput" /></view>
    <view class="form-row"><text class="label">支出用途</text><input class="input" value="{{costForm.purpose}}" data-field="purpose" bindinput="onCostInput" /></view>
    <view class="form-row"><text class="label">支出分类</text><picker mode="selector" range="{{costCategories}}" bindchange="onCostCategoryPick"><view class="picker-box">{{costForm.category || '请选择支出分类'}}</view></picker></view>
    <view class="form-row"><text class="label">备注</text><textarea class="textarea" value="{{costForm.remark}}" data-field="remark" bindinput="onCostInput" /></view>
    <view class="button-row"><button class="btn" bindtap="saveCost">{{costForm.id ? '保存成本' : '添加成本'}}</button><button class="btn secondary" bindtap="resetCostForm">清空</button></view>
  </view>

  <view class="section-title">日期筛选</view><view class="card filter-row"><picker mode="date" value="{{startDate}}" bindchange="onStartPick"><view class="picker-box">{{startDate || '开始日期'}}</view></picker><picker mode="date" value="{{endDate}}" bindchange="onEndPick"><view class="picker-box">{{endDate || '结束日期'}}</view></picker></view>
  <view class="toolbar"><button class="btn secondary" bindtap="toggleAll">{{allSelected ? '取消全选' : '全选一键'}}</button><button class="btn" bindtap="deleteSelected">删除选中</button></view>
  <view wx:if="{{records.length}}"><view class="record" wx:for="{{records}}" wx:key="id"><view class="record-head"><checkbox checked="{{selected[item.id]}}" data-id="{{item.id}}" bindtap="toggleOne" /><view class="record-title">{{item.date}}｜{{item.name}}</view><button size="mini" data-id="{{item.id}}" bindtap="editRecord">编辑</button></view><view class="record-text">{{item.spec}} ｜ {{item.qty}} 件 ｜ ¥{{item.price}} ｜ 合计 ¥{{item.total}}</view><view class="record-text">用途/备注：{{item.remark || '无'}}</view></view></view>
  <view class="empty" wx:else>暂无出库记录</view>

  <view class="section-title">成本记录</view><view class="toolbar"><button class="btn secondary" bindtap="toggleAllCosts">{{allCostsSelected ? '取消全选' : '全选一键'}}</button><button class="btn" bindtap="deleteCostSelected">删除选中</button></view>
  <view wx:if="{{costs.length}}"><view class="record" wx:for="{{costs}}" wx:key="id"><view class="record-head"><checkbox checked="{{selectedCosts[item.id]}}" data-id="{{item.id}}" bindtap="toggleCost" /><view class="record-title">{{item.date}}｜{{item.category}}</view><button size="mini" data-id="{{item.id}}" bindtap="editCost">编辑</button></view><view class="record-text">金额：¥{{item.amount}} ｜ 用途：{{item.purpose}}</view><view class="record-text">备注：{{item.remark || '无'}}</view></view></view>
  <view class="empty" wx:else>暂无成本记录</view>
</view>
