<view class="container">
  <view class="section-title">退货入库登记</view>
  <view class="card">
    <view class="form-row"><text class="label">退货日期</text><picker mode="date" value="{{form.date}}" bindchange="onDatePick"><view class="picker-box">{{form.date || '请选择退货日期'}}</view></picker></view>
    <view class="form-row"><text class="label">订单号</text><input class="input" value="{{form.orderNo}}" data-field="orderNo" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">物流公司</text><input class="input" value="{{form.expressCompany}}" data-field="expressCompany" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">物流单号</text><input class="input" value="{{form.expressNo}}" data-field="expressNo" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">库存商品</text><picker mode="selector" range="{{inventoryLabels}}" bindchange="onInventoryPick"><view class="picker-box">{{selectedLabel || '筛选库存内已有商品'}}</view></picker></view>
    <view class="form-row"><text class="label">商品名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">商品规格</text><input class="input" value="{{form.spec}}" data-field="spec" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">数量</text><input class="input" type="number" value="{{form.qty}}" data-field="qty" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">货物状态</text><picker mode="selector" range="{{cargoStates}}" bindchange="onStatePick"><view class="picker-box">{{form.state || '请选择货物状态'}}</view></picker></view>
    <view class="form-row"><text class="label">备注</text><textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" /></view>
    <view class="button-row"><button class="btn" bindtap="saveRecord">{{form.id ? '保存修改' : '添加退货'}}</button><button class="btn secondary" bindtap="resetForm">清空</button></view>
  </view>

  <view class="section-title">日期筛选</view><view class="card filter-row"><picker mode="date" value="{{startDate}}" bindchange="onStartPick"><view class="picker-box">{{startDate || '开始日期'}}</view></picker><picker mode="date" value="{{endDate}}" bindchange="onEndPick"><view class="picker-box">{{endDate || '结束日期'}}</view></picker></view>
  <view class="toolbar"><button class="btn secondary" bindtap="toggleAll">{{allSelected ? '取消全选' : '全选一键'}}</button><button class="btn" bindtap="deleteSelected">删除选中</button></view>
  <view wx:if="{{records.length}}"><view class="record" wx:for="{{records}}" wx:key="id"><view class="record-head"><checkbox checked="{{selected[item.id]}}" data-id="{{item.id}}" bindtap="toggleOne" /><view class="record-title">{{item.date}}｜{{item.orderNo}}</view><button size="mini" data-id="{{item.id}}" bindtap="editRecord">编辑</button></view><view class="record-text">{{item.name}}｜{{item.spec}}｜{{item.qty}} 件｜{{item.state}}</view><view class="record-text">{{item.expressCompany}}：{{item.expressNo}} ｜ 备注：{{item.remark || '无'}}</view></view></view>
  <view class="empty" wx:else>暂无退货入库记录</view>
</view>
